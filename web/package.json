{
  "name": "moego-pet-match-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "npm run test:version && vitest run",
    "test:version": "node --test scripts/game-version.test.mjs",
    "game-version": "node scripts/game-version.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
