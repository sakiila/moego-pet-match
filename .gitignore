# 名录、上传原图和全部本地工作数据（可能含 EXIF 与同事资料）
/data/

.env
.env.*
!.env.example

# 运行凭据与部署状态只保留在本机/服务器；示例文件允许提交
/deploy/*.env
/deploy/*.env.*
!/deploy/*.env.example
/.claude/settings.json

# 宠物图片与名录数据不进 git（见 TECH_PLAN）
/assets/pets/

# 本地环境与构建产物
.idea/
.DS_Store
node_modules/
dist/
__pycache__/
*.pyc
*.tsbuildinfo

# 服务端本地图片缓存（可随时删除重建）
server/.cache/
server/.store/
