# 服务运行只需要下面这些变量。复制为 production.env 填好后放到服务器（chmod 600，不提交）。
# 不要把本机的完整 .env 拷到服务器：里面有数据库管理员连接、OpenAI 与个人令牌，服务运行用不到。
# 值用单引号包裹，避免 Docker Compose 把密码中的 $ 当变量插值。
# 不要添加 DATABASE_URL、DATABASE_SSL、OBJECT_STORE、HOST、PORT 等覆盖镜像运行方式的变量。

# RackNerd PostgreSQL 的 pet_match 库，使用 pet_match_app；仅在 Docker 内网传输。
# postgres://pet_match_app:<密码>@postgresql:5432/pet_match?sslmode=disable
PET_MATCH_DATABASE_URL=''

# Cloudflare R2（镜像默认 OBJECT_STORE=r2）；令牌只需 star 桶的对象读写
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_KEY_ID=''
R2_BUCKET_NAME='star'
# 当前 star 桶为 default jurisdiction，无需填写。仅 eu / fedramp 桶需要设置。
# R2_JURISDICTION=''

# Slack 头像与实时同事搜索：只需读取用户资料（users:read；有 users:read.email 时可按邮箱前缀搜索）
SLACK_BOT_TOKEN=''

# 新上传与资料删除申请的 Slack 通知（可选）：填 Slack 用户 ID（U 开头）即由 App 私信，Bob 为 U03FPQWGTN2；也可填频道 ID。
# 需要上面的 Bot 令牌带 chat:write、files:write（附预览照片）与 im:write（打开私信）权限，加权限后要重新安装 App。留空则不发通知。
SLACK_NOTIFY_CHANNEL=''

# Slack App 整宽链接预览（可选）：App 设置 Basic Information 里的 Signing Secret。
# 还需要 Bot 权限 links:read、links:write，App unfurl domains 登记 star.baobo.me，
# Event Subscriptions 的 Request URL 填 https://star.baobo.me/api/slack/events 并订阅 link_shared。留空则不开放该入口。
SLACK_SIGNING_SECRET=''

# 正式开局验证（必填）：创建仅允许 star.baobo.me 的 Non-Interactive Turnstile widget。
# secret 仅在服务器保存；禁止使用 Cloudflare 测试 key 或提交真实密钥到 git。
TURNSTILE_SITE_KEY=''
TURNSTILE_SECRET_KEY=''
